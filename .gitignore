(
echo node_modules/
echo build/
echo dist/
echo coverage/
echo .env
echo .env.*
echo !.env.example
echo *.log
echo npm-debug.log*
echo backend/uploads/*
echo !backend/uploads/.gitkeep
echo .idea/
